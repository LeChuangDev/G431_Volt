# =====================================================================
# .editorconfig — 不同编辑器/IDE 打开本工程时的统一基础格式
# 安装 EditorConfig 插件后自动生效（VS2022、CLion、VSCode 均支持）
# https://editorconfig.org
# =====================================================================
root = true

# ---- 所有文件的默认规则 ----
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ---- C / 汇编 / 链接脚本 / CMake ----
[*.{c,h,s,S,ld}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.cmake]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

# ---- Markdown：行尾两个空格才是换行，不能裁剪 ----
[*.md]
trim_trailing_whitespace = false
