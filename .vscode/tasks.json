{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译 Build",
            "type": "shell",
            "command": "cmake -P tools/build.cmake",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "烧录 Flash",
            "type": "shell",
            "command": "cmake -DTARGET=flash -P tools/build.cmake",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "clear": true,
                "showReuseMessage": false
            }
        }
    ]
}
